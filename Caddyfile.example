# ==============================================================================
# Chanakya Research Commons — Production HTTPS Reverse Proxy Template (Caddy)
# Replace "commons.example.edu" with your actual university domain before use.
# Caddy automatically provisions and renews Let's Encrypt TLS certificates.
# ==============================================================================

commons.example.edu {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
