# ==============================================================================
# Chanakya Research Commons - Environment Configuration Template
# Copy this file to .env and replace all placeholder values before running.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

APP_NAME="Chanakya Research Commons"
# Use "development" locally; set "production" + DEBUG=false on a public server
APP_ENV=development
DEBUG=true
ENABLE_SCHEDULER=true

# Database Configuration
# For Docker Compose / Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://chanakya:replace-with-strong-postgres-password@postgres:5432/chanakya_commons
# For zero-setup local laptop fallback (SQLite + DuckDB + Parquet):
DATABASE_URL=sqlite:///./data/chanakya_commons.db

# PostgreSQL Container Credentials (used by docker-compose.yml / docker-compose.prod.yml)
POSTGRES_USER=chanakya
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=chanakya_commons
POSTGRES_PORT=5432

# Security / JWT Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace-with-64-char-random-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MinIO / S3-Compatible Object Storage (Bronze raw lake)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=chanakya_minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_BUCKET_RAW=chanakya-raw-lake
MINIO_ENABLED=false

# Data Lake & Data Warehouse Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
PARQUET_DIR=./data/parquet
DUCKDB_PATH=./data_warehouse/duckdb/chanakya_dw.duckdb

# Embeddings & ML Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RANDOM_SEED=42

# External Scholarly Ingestion (Polite Pool / Open Access)
OPENALEX_MAILTO=research-commons@chanakyauniversity.edu.in
ARXIV_RATE_LIMIT_SECONDS=3.0
SEMANTIC_SCHOLAR_API_KEY=

# Local LLM for RAG Research Assistant (Ollama - optional; falls back to extractive grounded synthesis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Frontend / CORS
# In production set explicitly to your public HTTPS origin, e.g.: https://commons.example.edu
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Leave empty so Vite dev proxy (local) and Nginx /api/ proxy (Docker/prod) use same-origin relative URLs.
# Only set an absolute URL if hosting the frontend separately from the backend without a reverse proxy.
VITE_API_BASE_URL=
